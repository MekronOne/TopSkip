{
  "manifest_version": 3,
  "name": "Top Skip",
  "version": "3.2",
  "description": "Автоматическая оценка уроков в журнале Top Academy",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://journal.top-academy.ru/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Top Skip",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://journal.top-academy.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "top-skip@mekronone.github.io",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
